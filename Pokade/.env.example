# ===== Redis (dev: no password) =====
REDIS_PORT=6379

# ===== OpenAI (Spring AI) =====
OPENAI_API_KEY=sk-...
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_GRADE_MODEL=gpt-4o

# ===== Scrydex API (Pokemon card data) =====
