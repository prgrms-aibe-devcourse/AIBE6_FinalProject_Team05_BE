SCRYDEX_TEAM_ID=

# ===== Toss Payments (포인트 충전) =====
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# ===== Mail (SMTP) =====
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ===== AWS S3 =====
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
