# ===== 활성 프로파일 =====
# SPRING_PROFILES_ACTIVE=dev

# ===== PostgreSQL =====
POSTGRES_DB=pokade
POSTGRES_USER=pokade
POSTGRES_PASSWORD=pokade
POSTGRES_PORT=5432

# ===== Redis (dev: no password) =====
REDIS_PORT=6379

# ===== OpenAI (Spring AI) =====
OPENAI_API_KEY=sk-...
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_GRADE_MODEL=gpt-4o

# ===== Scrydex API (Pokemon card data) =====
SCRYDEX_API_KEY=
SCRYDEX_TEAM_ID=

# ===== Toss Payments (포인트 충전) =====
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# ===== Mail (SMTP) =====
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ===== AWS S3 =====
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=

# ===== OAuth2 - Google =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===== OAuth2 - Kakao =====
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# ===== JWT =====
# HS256 서명용 시크릿, 최소 32바이트(256bit) 이상 필요 — 미달 시 WeakKeyException으로 부팅 실패
JWT_SECRET=

# ===== 모니터링 (Prometheus/Grafana, docker-compose.observability.yml) =====
# Grafana 관리자 비밀번호. compose가 `:?`로 필수 지정하고 있어 비워두면(또는 미설정이면)
# `docker compose -f docker-compose.yml -f docker-compose.observability.yml up` 이 즉시 실패한다.
GRAFANA_ADMIN_PASSWORD=
# 관리자 대시보드(admin/metrics)가 조회할 Prometheus 주소 - 미설정 시 아래 기본값이 쓰인다
# PROMETHEUS_BASE_URL=http://localhost:9090
