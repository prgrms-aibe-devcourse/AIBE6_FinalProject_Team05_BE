{
  "title": "AI 등급진단 모니터링 (#358)",
  "uid": "pokade-ai-domain",
  "tags": ["pokade", "ai"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "AI 등급진단 전체 처리시간 P95 (ai.grade.duration)",
      "description": "MetricsConfig.AI_GRADE_SLO_NANOS(2s/5s/10s/30s/60s) 버킷 기반 p95. AiGradeService.grade() 전체(S3 업로드+Vision 호출+DB 저장) 소요시간.",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(ai_grade_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "grade p95",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Vision API 호출 평균 시간 (ai.grade.vision.duration)",
      "description": "SLO 버킷이 없는 지표라 p95 대신 평균(sum/count)만 본다. OpenAI Vision 호출 자체의 순수 소요시간.",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(ai_grade_vision_duration_seconds_sum[5m]) / rate(ai_grade_vision_duration_seconds_count[5m])",
          "legendFormat": "vision avg duration",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "진단 결과 분포 (ai.grade.result)",
      "description": "성공(무료/유료)/품질실패 비율. 품질실패가 급증하면 프롬프트나 이미지 가이드를 점검할 신호.",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(ai_grade_result_total{status=\"SUCCESS\", free=\"true\"}[5m])",
          "legendFormat": "success (free)",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(ai_grade_result_total{status=\"SUCCESS\", free=\"false\"}[5m])",
          "legendFormat": "success (paid)",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(ai_grade_result_total{status=\"QUALITY_FAIL\"}[5m])",
          "legendFormat": "quality fail",
          "refId": "C"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Vision API 재시도 (ai.grade.vision.retries)",
      "description": "높으면 Vision 쪽 일시 장애 신호. AiGradeService.evaluateQuality()가 최대 3회 재시도한다.",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(ai_grade_vision_retries_total[5m])",
          "legendFormat": "retries/s",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "동일 이미지 캐시 히트 (ai.grade.cache.hits)",
      "description": "#358 - 같은 사진(해시+모델 일치)으로 재요청해 Vision 호출을 생략하고 캐시된 결과를 무료로 반환한 횟수. 값이 클수록 중복 재제출로 인한 비용/비일관성을 그만큼 막아준 것.",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(ai_grade_cache_hits_total[5m])",
          "legendFormat": "cache hits/s",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "로컬 품질 검사로 Vision 호출 생략 (ai.grade.local_fail)",
      "description": "이미지 품질이 로컬 검사(ImageQualityChecker)에서 먼저 걸러져 Vision을 아예 안 부른 횟수 - 토큰 절약량 지표.",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(ai_grade_local_fail_total[5m])",
          "legendFormat": "local fail/s",
          "refId": "A"
        }
      ]
    }
  ]
}
